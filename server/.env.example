# Local values are examples only. Set real secrets in server/.env or the backend host.
NODE_ENV=development
PORT=5000
MONGO_URI=
CLIENT_ORIGIN=http://localhost:5173

# Independent random secrets, each at least 32 bytes.
JWT_SECRET=
JWT_EXPIRES_IN=1h
OTP_HASH_SECRET=
OTP_EXPIRY_MINUTES=5

# Server-side Cloudinary configuration for images and financial PDFs.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Server-side SMTP configuration for OTP and financial document email.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Optional development or catalog settings.
EMAIL_DELIVERY_ENABLED=true
EMAIL_DIAGNOSTICS=false
OTHER_SERVICE_ESTIMATED_DURATION_MINUTES=60
CARAPI_TOKEN=

# Explicit one-time Admin bootstrap. Set only when running bootstrap:admin.
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_PASSWORD=

# Development-only opt-in bootstrap/demo accounts; never use production passwords.
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
DEV_MECHANIC_EMAIL=
DEV_MECHANIC_PASSWORD=
DEMO_CLIENT_EMAIL=
DEMO_CLIENT_PASSWORD=
