PORT=5000
NODE_ENV=development
# Local development opt-in. Production always ignores DEV_AUTO_VERIFY_EMAIL.
EMAIL_DELIVERY_ENABLED=true
DEV_AUTO_VERIFY_EMAIL=false
CLIENT_ORIGIN=http://localhost:5173
# Leave empty to run the Phase 1 API without a database.
# Replace placeholders with your Atlas connection details in .env only:
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/toyota_autocare
MONGO_URI=

# Generate independent random secrets, at least 32 bytes each. Never commit real values.
JWT_SECRET=
JWT_EXPIRES_IN=1h
OTP_HASH_SECRET=
OTP_EXPIRY_MINUTES=5

# Brevo SMTP login and SMTP key (not the Brevo API key).
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_PASS=
EMAIL_FROM=

# Optional explicit one-time bootstrap script; prefer temporary process environment values.
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_PASSWORD=

# Optional development test accounts: npm run bootstrap:dev-users
# Requires NODE_ENV=development. Passwords: 12+ characters, at most 72 UTF-8 bytes.
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
DEV_MECHANIC_EMAIL=
DEV_MECHANIC_PASSWORD=

# Optional development demo Client: npm run seed:demo also uses DEV_ADMIN_* and DEV_MECHANIC_*.
# The seed never overwrites existing accounts or records and never creates Bookings/Job Orders.
DEMO_CLIENT_EMAIL=
DEMO_CLIENT_PASSWORD=
